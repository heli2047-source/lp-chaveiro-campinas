---
import { siteConfig } from '../data/siteConfig';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`;
---

<section class="relative pt-6 sm:pt-12 pb-12 sm:pb-16 overflow-hidden border-b border-rescue-border">
  <!-- Fundo com gradiente radial sutil de emergência vermelho da marca -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-15%,rgba(218,25,7,0.18),transparent_70%)] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center">
    <!-- Eyebrow Pill Badge (Urgência & Escopo Híbrido) -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rescue-red/10 border border-rescue-red/30 text-rescue-red-light text-xs sm:text-sm font-bold tracking-wide uppercase shadow-sm mb-4">
      <span class="w-2 h-2 rounded-full bg-rescue-red animate-pulse"></span>
      🚨 Plantão 24h — Residencial & Automotivo em Campinas e RMC
    </div>

    <!-- H1 Headline Focada na Dor Imediata -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-[1.15] mb-4">
      Trancado para fora ou perdeu a chave? <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-rescue-red-light via-red-500 to-rescue-red">
        Chegamos em até 30 minutos.
      </span>
    </h1>

    <!-- Subheadline Clara com Solução de Dores -->
    <p class="text-base sm:text-xl text-rescue-text-muted max-w-2xl mx-auto leading-relaxed mb-8">
      Abertura de carros e residências <strong class="text-white font-semibold">sem arrombamento</strong>, chaves codificadas e canivetes na hora, <strong class="text-white font-semibold">socorro de bateria</strong> e troca de pneus com valor até <span class="text-emerald-400 font-bold">60% menor</span> que concessionárias.
    </p>

    <!-- Caixa de CTAs de Alta Conversão Mobile-First -->
    <div class="flex flex-col sm:flex-row items-stretch justify-center gap-3 sm:gap-4 max-w-lg mx-auto mb-8">
      <!-- Botão WhatsApp Primário (Destaque Máximo de Conversão) -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target min-h-[56px] px-6 py-4 rounded-xl bg-rescue-whatsapp hover:bg-rescue-whatsapp-hover text-rescue-bg font-black text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg whatsapp-glow transition-all transform active:scale-95"
        aria-label="Chamar Chaveiro Rodrigues pelo WhatsApp"
      >
        <span class="text-2xl animate-bounce">💬</span>
        <div class="text-left">
          <span class="block text-xs uppercase tracking-wider font-extrabold opacity-90">Atendimento Imediato</span>
          <span>CHAMAR NO WHATSAPP</span>
        </div>
      </a>

      <!-- Botão Click-to-Call (Ligação Direta) -->
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="touch-target min-h-[56px] px-6 py-4 rounded-xl bg-rescue-bg-elevated hover:bg-rescue-surface border-2 border-rescue-red text-white font-bold text-base flex items-center justify-center gap-3 transition-all active:scale-95 emergency-glow"
        aria-label={`Ligar Agora para o Chaveiro Rodrigues no telefone ${siteConfig.phoneDisplay}`}
      >
        <span class="text-xl text-rescue-red">📞</span>
        <div class="text-left">
          <span class="block text-[11px] uppercase tracking-wider text-rescue-red-light font-extrabold">Ligue Grátis 24h</span>
          <span class="font-black text-base sm:text-lg">{siteConfig.phoneDisplay}</span>
        </div>
      </a>
    </div>

    <!-- Micro-Selos de Confiança Imediata -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 max-w-3xl mx-auto pt-2 text-left sm:text-center">
      <div class="flex items-center sm:justify-center gap-2 px-3 py-2 rounded-xl bg-rescue-surface/50 border border-rescue-border text-xs text-slate-200">
        <span class="text-base text-rescue-red-light">⚡</span>
        <span>Até <strong>30 minutos</strong></span>
      </div>

      <div class="flex items-center sm:justify-center gap-2 px-3 py-2 rounded-xl bg-rescue-surface/50 border border-rescue-border text-xs text-slate-200">
        <span class="text-base text-emerald-400">🛡️</span>
        <span><strong>Sem danos</strong> à lataria</span>
      </div>

      <div class="flex items-center sm:justify-center gap-2 px-3 py-2 rounded-xl bg-rescue-surface/50 border border-rescue-border text-xs text-slate-200">
        <span class="text-base text-rescue-chrome">🚗🏠</span>
        <span><strong>Auto & Residencial</strong></span>
      </div>

      <div class="flex items-center sm:justify-center gap-2 px-3 py-2 rounded-xl bg-rescue-surface/50 border border-rescue-border text-xs text-slate-200">
        <span class="text-base text-blue-400">💳</span>
        <span>Pix ou <strong>12x no cartão</strong></span>
      </div>
    </div>
  </div>
</section>
