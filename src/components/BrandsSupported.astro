---
import { siteConfig } from '../data/siteConfig';
---

<section class="py-10 sm:py-14 bg-rescue-bg-card/70 border-b border-rescue-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
    <span class="text-xs font-bold uppercase tracking-wider text-rescue-red-light">
      Montadoras Nacionais e Importadas
    </span>
    <h2 class="text-xl sm:text-2xl font-black text-white mt-1 mb-6">
      Atendimento Completo para Todas as Marcas e Modelos
    </h2>

    <!-- Grid de Montadoras -->
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-2.5 sm:gap-3">
      {siteConfig.brands.map((brand) => (
        <div class="px-3 py-2.5 rounded-xl bg-rescue-surface/60 border border-rescue-border flex flex-col items-center justify-center hover:border-rescue-red/40 transition-colors">
          <span class="text-[10px] font-black tracking-widest text-rescue-red-light opacity-80 uppercase">
            {brand.logo}
          </span>
          <span class="text-xs font-bold text-slate-200 mt-0.5">
            {brand.name}
          </span>
        </div>
      ))}
    </div>

    <p class="text-xs text-rescue-text-muted mt-5">
      Carros populares, sedans, SUVs, picapes, vans e importados premium. Possuímos tecnologia para transponders e lâminas de mais de 500 modelos.
    </p>
  </div>
</section>
