---
import { siteConfig } from '../data/siteConfig';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-40 bg-rescue-bg/95 backdrop-blur-md border-b border-rescue-border/90 shadow-lg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between gap-3">
    <!-- Logomarca Oficial Chaveiro Rodrigues -->
    <a href={baseUrl} class="flex items-center gap-3 group focus:outline-none" aria-label="Chaveiro Rodrigues 24h - Página Inicial">
      <img
        src={`${baseUrl}images/logo-transparent.png`}
        alt="Chaveiro Rodrigues 24hs — Residencial e Automotivo"
        class="h-9 sm:h-11 md:h-12 w-auto object-contain transition-transform group-hover:scale-105"
        width="240"
        height="90"
        loading="eager"
      />
      <div class="hidden lg:block border-l border-rescue-border pl-3">
        <span class="block text-xs font-black text-white tracking-wider uppercase">
          Plantão 24 Horas
        </span>
        <span class="block text-[11px] text-rescue-text-muted">
          Campinas e Região
        </span>
      </div>
    </a>

    <!-- Status Ao Vivo & Ações Rápidas -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Badge de Status Ativo -->
      <div class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rescue-surface/80 border border-rescue-border text-xs font-semibold text-slate-300">
        <span class="w-2 h-2 rounded-full bg-rescue-red animate-pulse"></span>
        <span>Plantão Ativo</span>
      </div>

      <!-- Botão Click-to-Call (Desktop / Tablet) -->
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-rescue-surface hover:bg-rescue-border border border-rescue-red/40 hover:border-rescue-red text-white text-xs font-black transition-all shadow-sm group"
        aria-label={`Ligar para o Chaveiro Rodrigues no telefone ${siteConfig.phoneDisplay}`}
      >
        <span class="text-rescue-red group-hover:scale-110 transition-transform">📞</span>
        <span>{siteConfig.phoneDisplay}</span>
      </a>

      <!-- Botão WhatsApp Primário -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl bg-rescue-whatsapp hover:bg-rescue-whatsapp-hover text-rescue-bg font-black text-xs sm:text-sm transition-all shadow-md whatsapp-glow active:scale-95"
        aria-label="Chamar Chaveiro Rodrigues no WhatsApp"
      >
        <span class="text-base">💬</span>
        <span class="hidden xs:inline">WhatsApp</span> 24h
      </a>
    </div>
  </div>
</header>
