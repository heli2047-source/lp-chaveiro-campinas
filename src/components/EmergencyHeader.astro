---
import { siteConfig } from '../data/siteConfig';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`;
---

<header class="sticky top-0 z-40 bg-rescue-bg/95 backdrop-blur border-b border-rescue-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
    <!-- Logo & Nome Fantasia -->
    <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-rescue-surface border border-rescue-amber/40 flex items-center justify-center text-xl shadow-inner group-hover:border-rescue-amber transition-colors">
        🔑
      </div>
      <div>
        <span class="block text-sm sm:text-base font-extrabold tracking-tight text-white leading-tight">
          CHAVEIRO CAMPINAS <span class="text-rescue-amber">24H</span>
        </span>
        <span class="block text-[11px] text-rescue-text-muted font-medium">
          Socorro Automotivo Móvel
        </span>
      </div>
    </a>

    <!-- Status Ao Vivo & Ação Rápida no Topo -->
    <div class="flex items-center gap-2 sm:gap-4">
      <!-- Badge de Status Ativo -->
      <div class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Plantão Ativo em Campinas
      </div>

      <!-- Botão Click-to-Call no Topo -->
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="hidden md:inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-rescue-surface hover:bg-rescue-border border border-rescue-border text-white text-xs font-bold transition-all"
        aria-label="Ligar para o Chaveiro 24h"
      >
        <span>📞</span>
        <span>{siteConfig.phoneDisplay}</span>
      </a>

      <!-- Botão WhatsApp Primário (Desktop) -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-lg bg-rescue-whatsapp hover:bg-rescue-whatsapp-hover text-rescue-bg font-extrabold text-xs sm:text-sm transition-all shadow-md"
      >
        <span class="text-base">💬</span>
        <span class="hidden xs:inline">Socorro</span> WhatsApp
      </a>
    </div>
  </div>
</header>
