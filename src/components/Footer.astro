---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="bg-black border-t border-rescue-border text-rescue-text-muted py-12 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 text-xs sm:text-sm">
    <!-- Coluna 1: Dados da Empresa e Logo Oficial -->
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <img
          src={`${baseUrl}images/logo-transparent.png`}
          alt={siteConfig.tradeName}
          class="h-10 sm:h-12 w-auto object-contain"
          width="200"
          height="75"
          loading="lazy"
        />
      </div>
      <p class="text-rescue-text-dim text-xs leading-relaxed">
        Especialistas em chaves codificadas, presença, canivetes e abertura técnica sem danos de carros e residências. Socorro de bateria e troca de pneus com plantão móvel 24h em Campinas e RMC.
      </p>
      <div class="text-xs text-rescue-text-dim pt-1 space-y-1">
        <p><strong>Razão Social:</strong> {siteConfig.companyName}</p>
        <p><strong>CNPJ:</strong> {siteConfig.cnpj}</p>
        <p><strong>Base Central:</strong> {siteConfig.address}</p>
      </div>
    </div>

    <!-- Coluna 2: Contato Rápido de Emergência -->
    <div class="space-y-3">
      <span class="font-bold text-white text-sm block uppercase tracking-wider">
        Central de Plantão 24h
      </span>
      <ul class="space-y-2 text-xs">
        <li class="flex items-center gap-2 text-slate-200">
          <span class="text-rescue-red-light">📞</span>
          <a href={`tel:${siteConfig.phoneRaw}`} class="hover:text-rescue-red-light transition-colors font-bold">
            {siteConfig.phoneDisplay} (Ligue Grátis 24h)
          </a>
        </li>
        <li class="flex items-center gap-2 text-slate-200">
          <span class="text-emerald-400">💬</span>
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-emerald-400 transition-colors font-bold"
          >
            WhatsApp: {siteConfig.phoneDisplay}
          </a>
        </li>
        <li class="text-rescue-text-dim">
          ⏰ Atendimento ininterrupto 24 Horas de Domingo a Domingo
        </li>
      </ul>
    </div>

    <!-- Coluna 3: Formas de Pagamento & Garantia -->
    <div class="space-y-3">
      <span class="font-bold text-white text-sm block uppercase tracking-wider">
        Facilidades & Garantia
      </span>
      <ul class="space-y-2 text-xs text-rescue-text-dim">
        <li class="flex items-center gap-2 text-slate-300">
          <span class="text-emerald-400">💳</span>
          <span>Pagamento no débito, Pix ou cartão na maquininha</span>
        </li>
        <li class="flex items-center gap-2 text-slate-300">
          <span class="text-emerald-400">💵</span>
          <span>Dinheiro ou Pix com comprovante na hora</span>
        </li>
        <li class="flex items-center gap-2 text-slate-300">
          <span class="text-rescue-red-light">🛡️</span>
          <span>Garantia formal por escrito em serviços e peças</span>
        </li>
        <li class="flex items-center gap-2 text-slate-300">
          <span class="text-blue-400">🚐</span>
          <span>Van-oficina equipada direto no local sem guincho</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto border-t border-rescue-border/50 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-rescue-text-dim">
    <p>© {currentYear} {siteConfig.tradeName}. Todos os direitos reservados.</p>
    <p>Atendimento Móvel em Campinas e Região Metropolitana — SP.</p>
  </div>
</footer>
